# Copy these into Netlify -> Site configuration -> Environment variables
# (for local use: copy this file to .env.local and fill in real values)

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Your live site URL (use the Netlify URL after first deploy, or your custom domain)
NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app

# Server-only secret. NEVER prefix with NEXT_PUBLIC_. Only add if a feature needs it.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit (only needed for live classes)
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional multilingual AI features (server-only; never prefix these with NEXT_PUBLIC_)
# Point to a trusted LibreTranslate-compatible endpoint. Self-hosting is preferred for cost/privacy.
# The application appends /translate if you provide only the base URL.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional self-hosted speech/TTS service. The app appends /synthesize to this base URL.
# POST contract and response format are documented in MULTILINGUAL_SETUP.md.
EACHARYA_SPEECH_SERVICE_URL=
EACHARYA_SPEECH_SERVICE_TOKEN=

# Optional: official Azure Speech voices for spoken audio in Indian languages (free tier available).
# Without these, the app falls back to an unofficial Google voice that may be rate-limited.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
# Optional tuning for a slow local translation server (ms / characters)
# TRANSLATION_TIMEOUT_MS=120000
# TRANSLATION_CHUNK_CHARS=400
